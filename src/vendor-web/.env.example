# Same-origin: next.config.ts rewrites /api/* through to the backend on port
# 5000, so requests go wherever the page came from. That is correct for every
# visitor, not just whoever runs this machine. Copy this to .env.local.
NEXT_PUBLIC_API_URL=/api

# Where the rewrite forwards to. Change this if the backend moves off port 5000.
API_PROXY_TARGET=http://localhost:5000

# Hosts the dev server will serve to, for when this is exposed over a tunnel.
DEV_ALLOWED_ORIGINS=*.ngrok-free.dev,*.ngrok-free.app,*.ngrok.io
