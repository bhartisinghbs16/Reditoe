# =============================================================================
# Vinsta Backend – Environment Variables
# =============================================================================
# Copy this file to .env and fill in values. All config is read from .env only.
# Add any variables you had in .env.payment, .env.production, .env.twilio here.
# =============================================================================

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Auth (JWT) ─────────────────────────────────────────────────────────────
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# "Remember this device": a phone signed in with a code can come back without
# another one - for this many days from that code (using it does not extend it),
# and only this many phones per account (the least recently used is dropped).
# Signing out of the app revokes it. Keep both small.
# REMEMBER_DEVICE_DAYS=30
# MAX_REMEMBERED_DEVICES=3

# ─── Database ───────────────────────────────────────────────────────────────
# Leave unset for local: mongodb://127.0.0.1:27017/vinsta
# MONGODB_URI=mongodb://127.0.0.1:27017/vinsta
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/vinsta

# ─── Admin ──────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@vinsta.com
ADMIN_PASSWORD=admin123

# ─── URLs (add from .env.production) ────────────────────────────────────────
# Production API URL (for auto-wakeup, logging)
# PRODUCTION_URL=https://your-backend.onrender.com
# RENDER_EXTERNAL_URL=https://your-backend.onrender.com

# Admin dashboard & frontend (for reset links, CORS, WebSocket)
# ADMIN_DASHBOARD_URL=http://localhost:3000
# FRONTEND_URL=http://localhost:3000
# WS_DEV_ORIGIN=http://localhost:3000

# CORS (comma-separated in production)
# ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# ─── One-time codes (OTP) ───────────────────────────────────────────────────
#
# Used for sign-up verification, signing in by OTP, and password resets.
#
# The customer, vendor and delivery-partner apps sign in ONLY by mobile number
# and a code texted to it - there is no password. So SMS has to be configured
# below for those apps to work in production: with no provider, POST
# /api/auth/send-otp answers 503 on a production server.
#
# Outside production, with none of these set, the code is returned in the API
# response (as `devOtp`) and shown on screen instead of being sent, so every one
# of those flows can be completed without a mailbox or a phone. That is the demo
# behaviour, not the live one. ALLOW_DEBUG_OTP=true switches it on in production
# as well - never leave it on: anybody can then sign in as anybody.
# ALLOW_DEBUG_OTP=false
#
# Set BREVO_API_KEY to deliver by email, and the Twilio trio to deliver by SMS.
# Either may be set on its own. GET /api/auth/service-status reports which are
# live, and the apps stop showing codes on screen as soon as one is.
# BREVO_API_KEY=your-brevo-api-key
# Brevo refuses any sender address that has not been verified inside the Brevo
# account itself, so this must be an address confirmed there - not merely one
# that exists. An unverified sender fails silently.
# EMAIL_FROM=noreply@reditoe.com
# Brevo's SMTP credentials, for anything wanting a transport over the HTTP API.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-smtp-login
# SMTP_PASS=your-brevo-smtp-key

# Which provider carries the texts: msg91 (the default) or twilio.
# SMS_PROVIDER=msg91

# MSG91 — https://control.msg91.com
#
# The auth key is under Settings -> API. The template is created under
# Campaigns -> Templates, must be approved by the operator before it will
# send, and needs a variable named OTP - the code is passed in as ##OTP##.
# The sender id is the six-letter header the message arrives from.
#
# The codes themselves are generated and checked here, not by MSG91: the
# expiry, the resend cooldown and the limit on wrong guesses are this
# platform's, and the emailed codes follow the same rules. MSG91 is asked
# only to carry the message.
# MSG91_AUTH_KEY=your-msg91-auth-key
# MSG91_SENDER_ID=RDTILP
# SMS_DEFAULT_COUNTRY_CODE=91
#
# One template id per audience. DLT approves exact wording and the wording
# differs per audience - "Delivery Partner", "Reditoe Vendor" - so each is
# registered separately and has its own id. Whichever is not set falls back
# to MSG91_TEMPLATE_ID.
# MSG91_TEMPLATE_ID=id-of-the-customer-template
# MSG91_TEMPLATE_ID_VENDOR=id-of-the-vendor-template
# MSG91_TEMPLATE_ID_RIDER=id-of-the-delivery-partner-template
#
# The placeholder the approved template puts the code in. These read
# "...is ##num##", so the default is num. Sending it under a name the
# template does not use delivers a text with an empty gap where the code
# should be, which is worse than not sending at all.
# MSG91_OTP_VAR=num

# Twilio — the alternative
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+911234567890

# ─── Email (SendGrid) – alternative to Brevo ────────────────────────────────
# EMAIL_SERVICE=sendgrid
# SENDGRID_API_KEY=your-sendgrid-api-key
# EMAIL_USER=your-verified-sender@example.com
# SENDGRID_FROM_EMAIL=noreply@reditoe.com

# ─── Payments (Razorpay) ────────────────────────────────────────────────────
#
# This is the gateway the checkout uses. Both values come from the Razorpay
# dashboard, under Settings → API Keys.
#
#   rzp_test_… takes test cards only, and is the right one to check with first
#   rzp_live_… takes real money
#
# Until both are set the server answers the app with "gateway_not_configured"
# and orders are placed with their payment still pending, so the platform
# stays usable while the account is being set up. Set them, restart the API,
# and the checkout starts charging - nothing else needs changing.
#
# The amount charged is always read from the order in the database, never from
# the app, and the signature Razorpay returns is checked against the payment
# that was opened for that particular order.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ─── Payments (Cashfree) – alternative to Razorpay, not wired to the app ────
# CASHFREE_APP_ID=your-cashfree-app-id
# CASHFREE_SECRET_KEY=your-cashfree-secret-key
# CASHFREE_ENV=TEST

# ─── Platform ──────────────────────────────────────────────────────────────
# PLATFORM_COMMISSION_PERCENT=10

# ─── Rate Limiting ──────────────────────────────────────────────────────────
# RATE_LIMIT_MAX=200
# RATE_LIMIT_WINDOW_MS=900000

# ─── File Upload (Cloudinary) ───────────────────────────────────────────────
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ─── Base URL (for upload links, etc.) ──────────────────────────────────────
# BASE_URL=http://localhost:5000

# ─── Google Maps ────────────────────────────────────────────────────────────
# Required, not optional: without it delivery distance falls back to a
# straight line between the restaurant and the customer, which is always
# shorter than the road. On a Tirupati test route that measured 5.1km
# instead of 8.5km and charged 60 instead of 90 - the platform undercharges
# every delivery until this is set. The same key the admin console uses is
# fine; it must allow server-side calls (no HTTP-referrer restriction).
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ─── Firebase (Push Notifications) ─────────────────────────────────────────
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=your-client-email
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# ─── Redis (optional) ───────────────────────────────────────────────────────
# REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379

# ─── AWS S3 (if using cloud storage) ───────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_REGION=us-east-1

# ─── GCP / Azure (alternative cloud storage) ───────────────────────────────
# GCP_PROJECT_ID=
# GCP_STORAGE_BUCKET=
# GCP_KEY_FILENAME=
# AZURE_ACCOUNT_NAME=
# AZURE_ACCOUNT_KEY=
# AZURE_CONTAINER_NAME=

# ─── Multi-tenant (optional) ────────────────────────────────────────────────
# MULTI_TENANT_ENABLED=false

# ── Identity verification (CGPey) ───────────────────────────────────────────
# Verifies vendor and delivery-partner PAN, Aadhaar, bank, GST and driving
# licence during onboarding.
#
# These are NOT the portal login. The email and password used to sign in at
# portal.cgpey.com authenticate the dashboard only — API calls are rejected
# with "Missing required headers: x-merchant-id, x-api-key, x-secret-key".
# CGPey issues these three separately; ask them for API credentials for the
# merchant account.
#
# Each call is billed: PAN ₹1.77, Aadhaar OTP ₹0.99, Aadhaar verify ₹3.08,
# bank ₹1.77, GST ₹1.77, driving licence ₹4.45.
CGPEY_BASE_URL=https://verify.cgpey.com
CGPEY_MERCHANT_ID=
CGPEY_API_KEY=
CGPEY_SECRET_KEY=
CGPEY_TIMEOUT_MS=30000

# Public HTTPS URL used in shareable referral links
PUBLIC_REFERRAL_BASE_URL=https://api.reditoe.com/api/referral/open
