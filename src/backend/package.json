{
  "name": "vinsta-backend",
  "version": "1.0.0",
  "description": "Vinsta Multi-Vendor Food Delivery Backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "build": "echo 'No build step required for Node.js backend'",
    "dev": "nodemon server.js",
    "dev:local": "node scripts/dev-local.mjs",
    "seed:vendor": "node scripts/seed-vendor-demo.mjs",
    "seed:rbac": "node scripts/seed-rbac-roles.js",
    "seed:analytics": "node scripts/seed-analytics-data.js",
    "seed:invoices": "node scripts/seed-invoices.js",
    "seed:invoices-direct": "node scripts/seed-invoices-direct.js",
    "seed:invoices-simple": "node scripts/seed-invoices-simple.js",
    "seed:rider": "node scripts/seed-rider-data.js",
    "seed:all": "npm run seed:rbac && npm run seed:analytics && npm run seed:invoices && npm run seed:rider",
    "services:init": "node services/index.js",
    "test": "jest",
    "test:auth": "node --test tests/otp-auth.test.mjs",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "dev:delivery": "node scripts/dev-delivery.mjs",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "keywords": [
    "food-delivery",
    "multi-vendor",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1058.0",
    "@aws-sdk/lib-storage": "^3.932.0",
    "@sendgrid/mail": "^8.1.6",
    "autoprefixer": "^10.4.24",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^13.7.0",
    "google-auth-library": "^10.6.2",
    "html2canvas": "^1.4.1",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.0",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "nodemailer": "^6.9.7",
    "otplib": "^13.5.0",
    "postcss": "^8.5.6",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.1.18",
    "twilio": "^5.12.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "handlebars": "^4.7.8",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.3",
    "node-cron": "^3.0.3",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
