{
  "expo": {
    "name": "Reditoe",
    "slug": "reditoe-customer",
    "version": "1.0.16",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1ebf0e40-2972-4cd0-a64c-6ab56ba5727f"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reditoe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.reditoe.app",
      "versionCode": 24,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Reditoe uses your photos so you can choose a profile picture.",
          "cameraPermission": "Reditoe uses your camera so you can take a profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "./plugins/with-google-maps-key",
      "./plugins/with-no-session-backup",
      "./plugins/with-release-signing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/app"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1ebf0e40-2972-4cd0-a64c-6ab56ba5727f"
      }
    }
  }
}
