# The one backend every app talks to. Copy this to .env and adjust if needed.
#
# Expo inlines EXPO_PUBLIC_* into the bundle at build time. Restart the dev
# server after changing this — it is not read at runtime.
#
# Emulators and phones cannot reach "localhost" on your machine:
#   Android emulator → http://10.0.2.2:5000/api
#   Physical device  → http://<your-lan-ip>:5000/api
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Google Maps, for the live tracking map on the web build.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
