{
  "expo": {
    "name": "Reditoe Delivery Partner",
    "slug": "reditoe-rider",
    "version": "1.0.10",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/468b4a51-23af-47dc-ba77-06caba046518"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reditoerider",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#000000"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.reditoe.deliverypartner",
      "versionCode": 18,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-release-signing",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Reditoe uses the camera to scan pickup and delivery QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Reditoe uses your location, including in the background while you are on duty, to offer you delivery jobs near you and let customers follow their order.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "./plugins/with-no-session-backup",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/partner"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "468b4a51-23af-47dc-ba77-06caba046518"
      }
    },
    "owner": "punto7x"
  }
}
