{
  "expo": {
    "name": "Reditoe Vendor",
    "slug": "reditoe-vendor",
    "version": "1.0.10",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/e8ef4616-5fc8-400d-a8fe-1402c3c622ca"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reditoevendor",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#000000"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.reditoe.vendor",
      "versionCode": 17,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "allowBackup": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-release-signing",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Reditoe uses your location once, to record where your restaurant is so nearby riders can be matched to your orders."
        }
      ],
      "./plugins/with-no-session-backup"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/merchant"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e8ef4616-5fc8-400d-a8fe-1402c3c622ca"
      }
    }
  }
}
