# ==========================================================================
# Repo layout: backend (Express) + admin & vendor-web (Next.js)
#              + user, vendor, delivery (Expo / React Native)
# Lockfiles are deliberately NOT ignored — they pin the dependency tree.
# ==========================================================================

# ── Dependencies ──────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions

# ── Build output ──────────────────────────────────────────────────────────
.next/
out/
dist/
build/
web-build/
*.tsbuildinfo

# Generated by the frameworks on every run; never edited by hand.
next-env.d.ts
expo-env.d.ts

# ── Expo / React Native ───────────────────────────────────────────────────
.expo/
.expo-shared/
.metro-health-check*

# Produced by `expo prebuild`. Ignored because they are regenerated from
# app.json — delete these lines if you ever adopt the bare workflow and start
# hand-editing native code.
/user/ios/
/user/android/
/vendor/ios/
/vendor/android/
/delivery/ios/
/delivery/android/

# Native build artefacts
*.apk
*.aab
*.ipa
*.hprof
*.keystore
!debug.keystore

# ── Secrets and credentials ───────────────────────────────────────────────
# Anything here leaks the ability to sign, publish or spend money.
.env
.env.local
.env.*.local
!.env.example
*.pem
*.p8
*.p12
*.key
*.jks
*.mobileprovision
credentials.json
# google-services.json is Firebase's client config, not a secret - Google
# documents it as safe to commit, and it ships inside every APK regardless.
# It has to be in the repository or EAS will not upload it to the builder and
# the build silently loses push notifications.
# google-services.json
GoogleService-Info.plist

# ── Runtime data ──────────────────────────────────────────────────────────
backend/uploads/*
!backend/uploads/.gitkeep
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed

# ── Testing / tooling caches ──────────────────────────────────────────────
coverage/
.nyc_output/
.turbo/
.eslintcache
.vercel

# ── Editors ───────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ── Operating system ──────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ── Misc ──────────────────────────────────────────────────────────────────
*.local
*.tmp
tmp/
temp/

# The in-memory MongoDB's data directory — runtime state, recreated on boot.
backend/.mongo-data/

# Logs from run-demo.sh
.run-logs/

# npm and expo write these while installing, and they are not part of the
# project — one was committed by accident once already.
package.json.*
*.tmp.*
ngrok
